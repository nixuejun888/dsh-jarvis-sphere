{
  "name": "dsh-jarvis-sphere",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "贾维斯球：全息神经元球 + 记忆地图 + 操作员。球转速/亮度/脉冲随任务真实执行数据变化，球面每颗光点是一条真实记忆（位置固定、按类型着色、按重要度与新鲜度呼吸），并往会话注入 JARVIS 人格 + 9 个工具（记忆审计/归档备份/编年史/日报/自检/场景/提醒）。",
  "author": "nixuejun888",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jarvis",
    "visualization",
    "memory",
    "assistant",
    "hud",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nixuejun888/dsh-jarvis-sphere.git"
  },
  "homepage": "https://github.com/nixuejun888/dsh-jarvis-sphere",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "keeper.js",
    "backup.js",
    "memory-writer.js",
    "persona.md",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
